public class SocioGeek {
    private int numeroSocio;
    private String nombre;
    private int puntosFidelidad;

    public SocioGeek(int numeroSocio, String nombre, int puntosFidelidad) {
        this.numeroSocio = numeroSocio;
        this.nombre = nombre;
        this.puntosFidelidad = puntosFidelidad;
    }

    public int getNumeroSocio(){
        return this.numeroSocio;
    }

    public String getNombre(){
        return this.nombre;
    }

    public int getPuntosFidelidad(){
        return this.puntosFidelidad;
    }
    public void setPuntosFidelidad(int puntosFidelidad){
        if (puntosFidelidad >= 0){
            this.puntosFidelidad = puntosFidelidad;
        }else{
            System.out.println("Los puntos de fidelidad no pueden ser menores a 0");
        }
    }
}

public class Main {
    public static void main(String[] args){
        
        SocioGeek socio1 = new SocioGeek(1, "Gabriel", 67);

        System.out.println("Hola " + socio1.getNombre() + " su numero de socio es: " + socio1.getNumeroSocio() + " y sus puntos de fidelidad son: " + socio1.getPuntosFidelidad());

        socio1.setPuntosFidelidad(-15);

        System.out.println("Hola " + socio1.getNombre() + " su numero de socio es: " + socio1.getNumeroSocio() + " y sus puntos de fidelidad son: " + socio1.getPuntosFidelidad());
    }
}
